        <label>occupation force</label>
        <description>a group of soldiers from a spacer civilization. Armed with the best equipment that was assigned to them, they are part of efforts to "civilize" this world to support the colonial efforts.</description>
        <colorSpectrum>
            <li>(0, 0.737, 0.847)</li>
        </colorSpectrum>
        <isPlayer>true</isPlayer>
        <basicMemberKind>UFR_Occupiers</basicMemberKind>
