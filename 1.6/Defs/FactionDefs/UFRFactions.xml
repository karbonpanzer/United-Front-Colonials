    <FactionDef ParentName="FactionBase">
        <defName>UFR_ColonialAdministration</defName>
        <label>colonial administration</label>
        <description>a faction of colonists from a spacer civilization who are part of a colonization effort on this rimworld. These colonists come from all walks of life but all want to have a piece of the frontier before it is all gone.\n\nThey possess some spacer level military gear but lack the facilities to create more. Rather than rely on technology, they possess a strong will and cooperative spirit which has kept them going this long. They are generally willing to trade with outsiders and ally to those that are good friends to them, but will fiercely defend their new homes against any and all.</description>
        <categoryTag>Spacer</categoryTag>
        <pawnSingular>citizen</pawnSingular>
        <pawnsPlural>citizens</pawnsPlural>
        <listOrderPriority>13</listOrderPriority>
        <settlementGenerationWeight>1</settlementGenerationWeight>
        <requiredCountAtGameStart>1</requiredCountAtGameStart>
        <maxCountAtGameStart>1</maxCountAtGameStart>
        <canMakeRandomly>true</canMakeRandomly>
        <canSiege>true</canSiege>
        <canStageAttacks>true</canStageAttacks>
        <leaderTitle>governor</leaderTitle>
        <factionIconPath>UFR/UI/Factions/colonistadmin</factionIconPath>
        <factionNameMaker>Namer_UFRFactionColonial</factionNameMaker>
        <settlementNameMaker>NamerSettlementOutlander</settlementNameMaker>
        <colorSpectrum>
            <li>(0.80, 0.80, 0.95)</li>
        </colorSpectrum>
        <apparelStuffFilter>
            <thingDefs>
                <li>Cloth</li>
            </thingDefs>
        </apparelStuffFilter>
        <permanentEnemy>false</permanentEnemy>
        <techLevel>Spacer</techLevel>
        <allowedCultures>
            <li>Astropolitan</li>
        </allowedCultures>
        <requiredMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Collectivist</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">HumanPrimacy</li>
        </requiredMemes>
        <disallowedMemes>
            <li MayRequire="Ludeon.RimWorld.Ideology">Individualist</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Supremacist</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Cannibal</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">TreeConnection</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">AnimalPersonhood</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">NaturePrimacy</li>
            <li MayRequire="Ludeon.RimWorld.Ideology">Tunneler</li>
