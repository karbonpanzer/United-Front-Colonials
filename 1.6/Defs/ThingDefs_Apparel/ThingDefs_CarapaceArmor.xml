<?xml version='1.0' encoding='utf-8'?>
<Defs>

  <!-- Carapace Armor Parents-->
  <ThingDef Name="UFR_ApparelArmorCarapaceBase" ParentName="ArmorMachineableBase" Abstract="True">
    <colorGenerator Class="ColorGenerator_Single">
      <!-- Near Pure White -->
      <color>(0.95, 0.95, 0.95)</color>
    </colorGenerator>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <recipeUsers>
        <li>UFR_ArmamentsBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>      
    </recipeMaker>  
    <equippedStatOffsets>
      <MoveSpeed>-0.08</MoveSpeed>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.32</VacuumResistance>
    </equippedStatOffsets>
    <statBases>
      <Flammability>0.4</Flammability>
      <Insulation_Cold>34</Insulation_Cold>
      <Insulation_Heat>10</Insulation_Heat>
      <EquipDelay>6</EquipDelay>
    </statBases>
    <apparel>
      <useWornGraphicMask>true</useWornGraphicMask>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Neck</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <shellRenderedBehindHead>True</shellRenderedBehindHead>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>      
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <soundWear>Wear_PowerArmor</soundWear>
      <soundRemove>Remove_PowerArmor</soundRemove>
      <defaultOutfitTags>
        <li>Soldier</li>
        <li>Spacefarer</li>
      </defaultOutfitTags>  
      <tags>         
        <li>SpacerMilitary</li>
        <li>UFR_Armor</li>     
      </tags>
    </apparel>
    <techLevel>Spacer</techLevel>
    <comps>     
      <li Class="UnitedFront.Comps.CompPropertiesColorMarker"/>
      <li Class="CompProperties_Biocodable"/>
    </comps> 
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <tradeTags>
      <li>Armor</li>
      <li>HiTechArmor</li>
      <li>UFR_Armor</li>
    </tradeTags>
    <thingSetMakerTags>
      <li>RewardStandardHighFreq</li>
    </thingSetMakerTags>	  
  </ThingDef>  

  <ThingDef Name="UFR_ApparelArmorHelmetCarapaceBase" ParentName="ArmorHelmetMakeableBase" Abstract="True">
    <colorGenerator Class="ColorGenerator_Single">
      <!-- Near Pure White -->
