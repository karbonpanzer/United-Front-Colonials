    <equippedStatOffsets>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">0.8</ToxicEnvironmentResistance>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.69</VacuumResistance>
    </equippedStatOffsets>
    <statBases>
      <Flammability>0.4</Flammability>
      <Insulation_Cold>4</Insulation_Cold>
      <Insulation_Heat>2</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <apparel>
      <useWornGraphicMask>true</useWornGraphicMask>
      <renderSkipFlags>
        <li>Hair</li>
        <li>Beard</li>
      </renderSkipFlags>      
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
        <li>Spacefarer</li>
      </defaultOutfitTags>
      <tags>         
        <li>SpacerMilitary</li>         
        <li>UFR_Armor</li>        
      </tags>
    </apparel>
    <techLevel>Spacer</techLevel>
    <comps>
      <li Class="UnitedFront.Comps.CompPropertiesColorMarker" />
      <li Class="CompProperties_Biocodable"/>
    </comps>
    <thingCategories Inherit="False">
      <li>ArmorHeadgear</li>
    </thingCategories>
    <tradeTags>       
      <li>Armor</li>      
      <li>HiTechArmor</li>       
      <li>UFR_Armor</li>     
    </tradeTags>   
    <thingSetMakerTags>
      <li>RewardStandardHighFreq</li>
    </thingSetMakerTags>	  
  </ThingDef>
  
  <!-- Stock Carapace Armor -->
  <ThingDef ParentName="UFR_ApparelArmorCarapaceBase">
    <defName>UFR_CarapaceArmor</defName>
    <label>carapace armor</label>
    <description>A suit of armor, made up of a lightweight plasteel-weave plates which provide moderate protection and with an integrated webbing system configured for standard infantry use. Created as a cheaper alternative to power armor during conflicts. Armor like this is often used by imperial army regulars and urbworld military forces.</description>
    <graphicData>
      <texPath>UFR/Things/Pawn/Humanlike/Armor/CarapaceArmor/CarapaceArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <recipeMaker>
      <researchPrerequisite>UFR_CarapaceArmor</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Plasteel>70</Plasteel>
      <ComponentSpacer>3</ComponentSpacer>
      <Uranium>8</Uranium>
    </costList>
    <statBases>
      <WorkToMake>48000</WorkToMake>
      <MaxHitPoints>300</MaxHitPoints>
      <Mass>8</Mass>
      <ArmorRating_Sharp>0.86</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.42</ArmorRating_Blunt>
      <ArmorRating_Heat>0.48</ArmorRating_Heat>
    </statBases>
    <apparel>
      <wornGraphicPath>UFR/Things/Pawn/Humanlike/Armor/CarapaceArmor/CarapaceArmor</wornGraphicPath>
      <tags>
        <li>UFR_CarapaceArmor</li>
      </tags>
    </apparel>
    <modExtensions>
      <!--white -->
      <li Class="UnitedFront.Defs.ArmorColorExtension">
        <colorTwo>(0.95, 0.95, 0.95)</colorTwo>
      </li>
    </modExtensions>
  </ThingDef>

