  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>UFR_Vibrosword</defName>
    <label>frequency sword</label>
    <description>A compositie plasteel sword fitted with a resonator which vibrates the blade at high frequencies. The oscillation of the blade weakens the molecular structure of anything that it cuts, though it is quite heavy.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>UFR/Things/Item/Equipment/frequencysword</texPath>
    </graphicData>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <researchPrerequisite>UFR_HighFrequencyResonators</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
