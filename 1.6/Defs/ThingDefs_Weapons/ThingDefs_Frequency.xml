    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <ComponentSpacer>3</ComponentSpacer>
      <Plasteel>15</Plasteel>
    </costList>
    <statBases>
      <WorkToMake>36000</WorkToMake>
      <Mass>1.6</Mass>
    </statBases>
    <tools>
