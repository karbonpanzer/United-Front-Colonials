<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="UFR_AssaultPistol">
    <defName>UFR_AssaultPistol_Unique</defName>
    <label>unique assault pistol</label>
    <description>An assault pistol with customized parts.</description>
    <recipeMaker IsNull="True" />
    <graphicData>
      <texPath>UFR/Things/Item/Equipment/UniqueWeapons/AssaultPistol</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>0.85</drawSize>
    </graphicData>
    <comps Inherit="False">
      <li>
        <compClass>CompEquippable</compClass>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponGun</nameMaker>
        <descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
      <li Class="CompProperties_UniqueWeapon">
        <weaponCategories>
          <li>Ranged</li>
          <li>BulletFiring</li>
          <li>Gun</li>
          <li>Pistol</li>
          <li>Sighted</li>
        </weaponCategories>
        <namerLabels>
          <li>assault pistol</li>
          <li>pistol</li>
          <li>sidearm</li>
          <li>hand-cannon</li>
          <li>thumper</li>
        </namerLabels>
      </li>
    </comps>
    <generateAllowChance>0</generateAllowChance>
    <possessionCount>0</possessionCount>
    <tradeability>Sellable</tradeability>
    <thingSetMakerTags Inherit="False">
      <li>RewardStandardLowFreq</li>
      <li>UniqueWeapon</li>
    </thingSetMakerTags>
    <thingCategories Inherit="False">
      <li>WeaponsUnique</li>
    </thingCategories>
    <descriptionHyperlinks>
      <ThingDef>UFR_AssaultPistol</ThingDef>
    </descriptionHyperlinks>
  </ThingDef>

